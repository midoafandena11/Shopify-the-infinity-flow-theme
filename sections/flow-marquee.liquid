{%- assign fx_items = section.blocks -%}
{%- if fx_items.size > 0 -%}
  <div class="fx-marquee" style="--fx-speed: {{ section.settings.speed }}s" {{ section.shopify_attributes }}>
    <div class="fx-marquee__t">
      {%- for i in (1..2) -%}
        <div class="fx-marquee__g"{% if i == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in fx_items -%}
            <span class="fx-marquee__i" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
            </span>
            <span class="fx-marquee__s" aria-hidden="true">{%- render 'flow-icon', name: 'spark' -%}</span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Infinity ticker",
  "max_blocks": 8,
  "settings": [
    { "type": "range", "id": "speed", "min": 12, "max": 60, "step": 2, "unit": "s", "label": "Loop duration", "default": 30 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over 250" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Infinity ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "Drag any product to the cart" } },
        { "type": "item", "settings": { "text": "Free shipping on orders over 250" } },
        { "type": "item", "settings": { "text": "Easy returns" } }
      ]
    }
  ]
}
{% endschema %}
