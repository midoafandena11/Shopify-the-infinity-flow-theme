{%- comment -%}
  Infinity Flow product card. Accepts the same parameters Dawn's sections pass:
  card_product, media_aspect_ratio, show_secondary_image, lazy_load, section_id, placeholder_image
  Draggable onto the floating cart when settings.flow_enabled is on.
{%- endcomment -%}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign flow_on = false
  assign flow_multi = false
  if card_product and card_product != empty and settings.flow_enabled and card_product.available
    assign flow_on = true
  endif
  if card_product.variants_count > 1
    assign flow_multi = true
  endif
  assign fx_loading = 'lazy'
  if lazy_load == false
    assign fx_loading = 'eager'
  endif
-%}
{%- if card_product and card_product != empty -%}
  <div
    class="fx-card{% unless card_product.available %} is-soldout{% endunless %}"
    {% if flow_on %}
      data-flow-card
      data-flow-available="true"
      data-flow-multi="{{ flow_multi }}"
      data-flow-handle="{{ card_product.handle }}"
      data-flow-title="{{ card_product.title | escape }}"
    {% endif %}
  >
    <div class="fx-card__stage">
      <a class="fx-card__media" href="{{ card_product.url }}" tabindex="-1" aria-hidden="true">
        {%- if card_product.featured_media -%}
          {{
            card_product.featured_media
            | image_url: width: 720
            | image_tag:
              class: 'fx-card__img',
              loading: fx_loading,
              sizes: '(min-width: 990px) 25vw, 50vw',
              widths: '260, 360, 520, 720',
              alt: ''
          }}
          {%- if show_secondary_image and card_product.media.size > 1 -%}
            {{
              card_product.media[1]
              | image_url: width: 720
              | image_tag: class: 'fx-card__img fx-card__img--alt', loading: 'lazy', widths: '260, 360, 520, 720', alt: ''
            }}
          {%- endif -%}
        {%- else -%}
          <span class="fx-card__ph">{%- render 'flow-icon', name: 'bag' -%}</span>
        {%- endif -%}
      </a>

      {%- if card_product.available == false -%}
        <span class="fx-card__badge fx-card__badge--out">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif card_product.compare_at_price > card_product.price -%}
        {%- assign fx_off = card_product.compare_at_price | minus: card_product.price | times: 100 | divided_by: card_product.compare_at_price -%}
        <span class="fx-card__badge">-{{ fx_off }}%</span>
      {%- endif -%}

      {%- if flow_on -%}
        <span class="fx-card__grip" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><circle cx="9" cy="6" r="1.7"/><circle cx="15" cy="6" r="1.7"/><circle cx="9" cy="12" r="1.7"/><circle cx="15" cy="12" r="1.7"/><circle cx="9" cy="18" r="1.7"/><circle cx="15" cy="18" r="1.7"/></svg>
        </span>
        {%- assign flow_form_id = 'flow-form-' | append: section_id | append: '-' | append: card_product.id -%}
        {%- render 'flow-card-controls', card_product: card_product, form_id: flow_form_id, flow_multi: flow_multi -%}
      {%- endif -%}
    </div>

    <div class="fx-card__info">
      <h3 class="fx-card__title"><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
      <div class="fx-card__price">{%- render 'price', product: card_product, price_class: '', show_compare_at_price: true -%}</div>
    </div>
  </div>
{%- else -%}
  <div class="fx-card">
    <div class="fx-card__stage">
      <span class="fx-card__media fx-card__media--ph">{{ placeholder_image | default: 'product-apparel-1' | placeholder_svg_tag: 'fx-card__svg' }}</span>
    </div>
    <div class="fx-card__info">
      <h3 class="fx-card__title">{{ 'onboarding.product_title' | t }}</h3>
      <div class="fx-card__price">{%- render 'price', placeholder: true, show_compare_at_price: true -%}</div>
    </div>
  </div>
{%- endif -%}
