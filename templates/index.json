{
  "sections": {
    "categories": {
      "type": "flow-categories",
      "settings": {
        "heading": "Top categories",
        "placeholder_label": "Category"
      }
    },
    "feed": {
      "type": "flow-feed",
      "settings": {
        "collection": "all",
        "heading": "Dynamic feed",
        "subheading": "Continuous shopping flow",
        "layout": "grid",
        "limit": 8,
        "show_toggle": true,
        "show_hint": true
      }
    },
    "banners": {
      "type": "flow-promo",
      "blocks": {
        "b1": {
          "type": "tile",
          "settings": {
            "art": "a",
            "tag": "New",
            "heading": "Fresh arrivals",
            "text": "Just landed. Drag your favorites to the cart.",
            "label": "Shop now"
          }
        },
        "b2": {
          "type": "tile",
          "settings": {
            "art": "b",
            "tag": "Limited",
            "heading": "Best sellers",
            "text": "What everyone is dropping in their cart.",
            "label": "Discover"
          }
        }
      },
      "block_order": [
        "b1",
        "b2"
      ],
      "settings": {}
    },
    "rail": {
      "type": "flow-feed",
      "settings": {
        "collection": "all",
        "heading": "Picked for you",
        "subheading": "",
        "layout": "rail",
        "limit": 10,
        "show_toggle": false,
        "show_hint": false,
        "link_label": "View all"
      }
    },
    "trust": {
      "type": "flow-trust",
      "blocks": {
        "t1": {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Fast delivery",
            "text": "Ships in 24 hours"
          }
        },
        "t2": {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "Easy returns",
            "text": "14 days, no questions"
          }
        },
        "t3": {
          "type": "item",
          "settings": {
            "icon": "shield",
            "title": "Secure payment",
            "text": "Protected checkout"
          }
        },
        "t4": {
          "type": "item",
          "settings": {
            "icon": "heart",
            "title": "Loved by many",
            "text": "Thousands of happy customers"
          }
        }
      },
      "block_order": [
        "t1",
        "t2",
        "t3",
        "t4"
      ],
      "settings": {}
    },
    "slider": {
      "type": "flow-slider",
      "blocks": {
        "s1": {
          "type": "slide",
          "settings": {
            "bg": "#0E4F4C",
            "fg": "#F5F1E8",
            "badge": "Limited offer",
            "heading": "First purchase, enjoy a special offer",
            "button_label": "Shop now"
          }
        },
        "s2": {
          "type": "slide",
          "settings": {
            "bg": "#D9BC7E",
            "fg": "#0B2E2C",
            "badge": "New",
            "heading": "Fresh arrivals just landed",
            "button_label": "Discover"
          }
        },
        "s3": {
          "type": "slide",
          "settings": {
            "bg": "#DDEDEA",
            "fg": "#0B2E2C",
            "badge": "Free shipping",
            "heading": "Drag it to the cart, we do the rest",
            "button_label": "Start"
          }
        }
      },
      "block_order": [
        "s1",
        "s2",
        "s3"
      ],
      "settings": {
        "autoplay": 5,
        "height": "regular",
        "show_dots": true
      }
    }
